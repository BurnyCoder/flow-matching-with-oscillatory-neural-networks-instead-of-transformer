# Local: default runtime options. Global: reproducible values are copied into every run's config.json.
OFM_DEVICE=cuda
OFM_DATA_ROOT=data
OFM_RUNS_ROOT=runs
OFM_BUDGET_HOURS=24
OFM_BATCH_SIZE=128
OFM_MICROBATCH=32
OFM_CPU_THREADS=4
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
UV_CACHE_DIR=.cache/uv
# Supply HF_TOKEN locally only if needed for publication. Never commit a token.
HF_NAMESPACE=BurnyCoder
